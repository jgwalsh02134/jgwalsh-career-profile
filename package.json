{
  "name": "jgwalsh-career-profile",
  "version": "1.0.0",
  "description": "J. Gregory Walsh Career Profile Website - Optimized",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "optimize:css": "postcss assets/css/style.css -o assets/css/style.min.css",
    "optimize:html": "node scripts/optimize-html.js",
    "build:all": "npm run optimize:css && npm run build && npm run optimize:html",
    "analyze": "webpack-bundle-analyzer dist/stats.json"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^6.10.0",
    "css-minimizer-webpack-plugin": "^6.0.0",
    "cssnano": "^6.1.0",
    "html-webpack-plugin": "^5.6.0",
    "mini-css-extract-plugin": "^2.8.1",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.3",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.2",
    "workbox-webpack-plugin": "^7.0.0"
  },
  "dependencies": {
    "intersection-observer": "^0.12.2"
  }
}