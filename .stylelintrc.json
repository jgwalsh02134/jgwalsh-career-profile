{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-order"
  ],
  "ignoreFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.wrangler/**",
    "**/*.min.css"
  ],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "layer",
          "variants",
          "responsive",
          "screen"
        ]
      }
    ],
    "order/properties-alphabetical-order": true,
    "selector-class-pattern": null,
    "value-keyword-case": null
  }
}
